{
  "name": "bg-sales-management",
  "productName": "BG Sales Management",
  "version": "0.17.0",
  "description": "Quản lý doanh số, kế hoạch công tác và tác vụ khách hàng BG",
  "main": "main.js",
  "author": "BG",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never",
    "test": "node tools/test_uiupdate.js && node tools/test_ci_ui.js && node tools/test_main_flow.js && node tests/amis-core.test.js && node tests/amis-client.test.js && node tools/test_backup.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^39.8.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "vn.bg.salesmanagement",
    "productName": "BG Sales Management",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "electronLanguages": [
      "vi",
      "en-US"
    ],
    "files": [
      "main.js",
      "preload.js",
      "backup.js",
      "amis.js",
      "amis-core.js",
      "uiupdate.js",
      "index.html",
      "assets/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "BG Sales Management",
      "artifactName": "BG-Sales-Management-Setup-${version}.${ext}",
      "differentialPackage": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Alesnguyen",
        "repo": "bg-sales-management-releases",
        "releaseType": "release"
      }
    ]
  }
}
