{
  "name": "bg-sales-management",
  "productName": "BG Sales Management",
  "version": "0.10.1",
  "description": "Quản lý doanh số, kế hoạch công tác và tác vụ khách hàng BG",
  "main": "main.js",
  "author": "BG",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": { "electron-updater": "^6.3.9" },
  "devDependencies": { "electron": "^39.8.5", "electron-builder": "^26.15.3" },
  "build": {
    "appId": "vn.bg.salesmanagement",
    "productName": "BG Sales Management",
    "directories": { "output": "dist", "buildResources": "build" },
    "electronLanguages": ["vi", "en-US"],
    "files": ["main.js", "preload.js", "backup.js", "index.html", "assets/**", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "BG Sales Management" },
    "publish": [{ "provider": "github", "owner": "Alesnguyen", "repo": "bg-sales-management-releases", "releaseType": "release" }]
  }
}
